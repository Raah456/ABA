# Copy to .env on the server and fill in. Never commit .env.

# The web address staff will use. Point its DNS A record at the server first.
DOMAIN=aba.yourpractice.com

# 32-byte key that encrypts backups and two-factor secrets. Generate with:
#   openssl rand -base64 32      (or: npm run keygen)
# Save it in a password manager (two people should have it). Without it, backups
# cannot be restored and everyone's two-factor sign-in must be reset.
APP_ENCRYPTION_KEY=

# First sign-in account, created only when the database is empty.
# Remove ADMIN_PASSWORD from this file after the first sign-in.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# Backups (defaults shown)
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=30
BACKUP_KEEP_MONTHS=12

# Optional off-site copy (docker compose --profile offsite up -d).
# Example for an AWS S3 bucket covered by your AWS BAA:
OFFSITE_REMOTE=offsite:your-bucket-name/aba-backups
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=AWS
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_REGION=us-east-1
